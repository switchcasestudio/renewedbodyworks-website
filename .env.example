# Google Analytics 4 — set to start collecting the four conversion events
# (phone_tap, contact_submit, book_click_eugene, book_click_portland).
# Closes audit finding MEA-01. Leave blank in dev.
NEXT_PUBLIC_GA_ID=

# Live Google review count + rating (optional).
# Without these the site falls back to the numbers in lib/business.ts and
# renders exactly as before, so it is safe to deploy without them.
#
#   GOOGLE_PLACES_API_KEY  Google Cloud key with the "Places API (New)" enabled.
#                          Restrict it to your server IPs; it is never exposed
#                          to the browser.
#   GOOGLE_PLACE_ID        The profile's Place ID (starts with "ChIJ"). Find it
#                          at developers.google.com/maps/documentation/places/web-service/place-id
#                          by searching "Renewed Bodyworks Portland OR".
#
# Note: Google returns at most 5 reviews per place and offers no pagination,
# so the carousel shows the curated quotes plus whatever Google returns.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
